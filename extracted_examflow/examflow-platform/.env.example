# PostgreSQL connection string. Use a managed PostgreSQL database such as Supabase.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# For hosted databases that require SSL:
PGSSL=true

PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# First admin account is created automatically if it does not already exist.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
